# Video source consumed by the video worker.
VIDEO_SOURCE=http://host.docker.internal:8080/?action=stream

# Maximum number of frames processed per second.
FPS_LIMIT=15

# JPEG output quality, from 1 to 100.
JPEG_QUALITY=80

# YOLO worker WebSocket endpoint used by the video worker.
YOLO_WORKER_URL=ws://yolo-worker:8002/inference

# Inference confidence threshold used by the YOLO worker.
CONFIDENCE_THRESHOLD=0.2

# Optional endpoint used by tools/send_frame.py when running locally.
YOLO_WS=ws://127.0.0.1:8002/inference

# Service bind settings used by the YOLO worker container.
HOST=0.0.0.0
PORT=8002

# ROCm inference device. Use "0" for the first GPU or "cpu" without GPU passthrough.
DEVICE=0