# Choose one source: webcam-windows, webcam-linux, or the printer camera URL.
VIDEO_SOURCE=webcam-windows
WEBCAM_INDEX=0

# 3D printer camera option:
# VIDEO_SOURCE=http://<printer-ip>:8080/?action=stream

# Maximum number of frames processed per second.
FPS_LIMIT=15

# JPEG output quality, from 1 to 100.
JPEG_QUALITY=80

# YOLO worker WebSocket endpoint used by the video worker.
YOLO_WORKER_URL=ws://yolo-worker:8002/inference

# Published and internal service ports.
YOLO_WS_PORT=8002
YOLO_WS_INTERNAL_PORT=8002
YOLO_HTTP_PORT=8003
YOLO_HTTP_INTERNAL_PORT=8003
VIDEO_WORKER_PORT=8010
VIDEO_WORKER_INTERNAL_PORT=8010
VIDEO_WORKER_HOST=video-worker
FRONTEND_PORT=8090
FRONTEND_INTERNAL_PORT=80
YOLO_WORKER_HOST=yolo-worker

# Inference confidence threshold used by the YOLO worker.
CONFIDENCE_THRESHOLD=0.2

# Optional endpoint used by tools/send_frame.py when running locally.
YOLO_WS=ws://127.0.0.1:8002/inference

# Service bind settings used by the YOLO worker container.
HOST=0.0.0.0
PORT=8002

# ROCm inference device. Use "0" for the first GPU or "cpu" without GPU passthrough.
DEVICE=0
IMAGE_SIZE=256
INFERENCE_HALF=false

# CPU parallelism used when ROCm is unavailable or falls back to CPU.
OMP_NUM_THREADS=16
MKL_NUM_THREADS=16
OPENBLAS_NUM_THREADS=16
NUMEXPR_NUM_THREADS=16
TORCH_NUM_THREADS=16
TORCH_INTEROP_THREADS=4

# Moonraker printer control and failure confirmation.
MOONRAKER_URL=http://<printer-ip>:7125
MOONRAKER_TIMEOUT_SECONDS=5
FAILURE_CONFIDENCE_THRESHOLD=0.60
FAILURE_CONFIRMATION_MODE=frames
FAILURE_CONFIRMATION_FRAMES=10
FAILURE_CONFIRMATION_TIME_SECONDS=5